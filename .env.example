# この追跡ファイルには変数名と説明だけを置き、値は常に空にする。
# 実値は GitHub の e2e Environment または Cloudflare Worker Secret へ直接登録する。

# GitHub e2e Environment secrets: Wrangler の非対話デプロイに使用する。
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# GitHub e2e Environment secret / Cloudflare Worker Secret の共有認証値。
INTERNAL_API_TOKEN=

# GitHub e2e Environment secret: ActionsログでマスクするE2E専用WorkerのHTTPS origin。
E2E_WORKER_URL=

# GitHub e2e Environment secret: 上記originのSHA-256。別accountへの誤送信を防ぐ。
E2E_WORKER_URL_SHA256=

# Cloudflare Worker Secrets: GitHub Actions へは複製しない。
GCAL_WEBHOOK_TOKEN=
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
NOTION_TOKEN=
NOTION_EVENT_INTERNAL_ID=
NOTION_QA_ID=
DISCORD_TOKEN=
DISCORD_GUILD_ID=
EVENT_CREATE_CHANNEL_ID=
EVENT_CREATE_ROLE_ID=
QA_CHANNEL_ID=
REMINDER_CHANNEL_ID=
REMINDER_ROLE_ID=
